rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin identity ────────────────────────────────────────────────────
    // Any Firebase Auth session signed in as team@twinspace360.com is admin.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.lower() == 'team@twinspace360.com';
    }

    // ── Listings ──────────────────────────────────────────────────────────
    // Public visitors can read published listings only.
    // Admin (team@twinspace360.com) can read/write everything (including unpublished drafts).
    match /listings/{id} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Messages (contact form) ───────────────────────────────────────────
    // Anyone can submit a contact message (create only).
    // Admin can read, update and delete.
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Admin sessions ────────────────────────────────────────────────────
    // Only admin can manage session tracking documents.
    match /admin_sessions/{id} {
      allow read, write: if isAdmin();
    }

    // ── Shoot pricing ─────────────────────────────────────────────────────
    // Public pricing page reads prices; only admin can update them.
    match /pricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
