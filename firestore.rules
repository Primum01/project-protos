rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // ADMIN IDENTIFICATION
    // =========================================================================
    // A user is recognized as Admin ONLY IF they are authenticated with Firebase
    // and their account email is team@twinspace360.com (case-insensitive).
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.lower() == 'team@twinspace360.com';
    }

    // =========================================================================
    // LISTINGS (Properties)
    // =========================================================================
    // PUBLIC USERS: Can only read/search listings where published == true.
    // ADMIN: Can read all listings (published and drafts), and can create,
    //        update, publish/unpublish, and permanently delete listings.
    match /listings/{id} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();

      // Invoices / receipts / financial attachments for this listing (Admin Only)
      match /documents/{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // =========================================================================
    // MESSAGES (Contact / Inquiry Form Submissions)
    // =========================================================================
    // PUBLIC USERS: Can create contact messages strictly adhering to the schema.
    //               Cannot read, update, or delete any messages.
    // ADMIN: Can read, update (mark read/unread), and delete messages.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id', 'name', 'email', 'phone', 'message', 'read', 'createdAt'])
                    && request.resource.data.id is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.read == false
                    && request.resource.data.createdAt is string;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // ADMIN SESSIONS (Active Session Tracking)
    // =========================================================================
    // PUBLIC USERS: Completely denied access.
    // ADMIN: Can read, create, update, and delete admin session records.
    match /admin_sessions/{id} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // SHOOT PRICING (Pricing Tiers)
    // =========================================================================
    // PUBLIC USERS: Can read pricing plans on the website.
    // ADMIN: Can update and modify pricing tier values.
    match /pricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // TOUR ANALYTICS (Real tour views, sessions, link shares)
    // =========================================================================
    // PUBLIC USERS: Can record tour view, session duration, and share events.
    // ADMIN: Can read, update, and manage analytics data.
    match /tour_analytics/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id', 'type', 'tourId', 'tourTitle', 'durationSeconds', 'timestamp'])
                    && request.resource.data.id is string
                    && request.resource.data.type in ['tour_view', 'session_duration', 'link_shared']
                    && request.resource.data.tourId is string
                    && request.resource.data.timestamp is string;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // INVOICES & RECEIPTS
    // =========================================================================
    // PUBLIC USERS: Completely denied access.
    // ADMIN: Can read, create, update, and delete invoice and receipt records.
    match /invoices/{id} {
      allow read, write: if isAdmin();
    }
    match /receipts/{id} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // PROPERTY COUNTERS & ACCOUNT NUMBERS (Per-area atomic sequence counters)
    // =========================================================================
    // PUBLIC USERS: Completely denied.
    // ADMIN: Can read, write, and manage per-area sequence counters and uniqueness locks.
    match /property_counters/{id} {
      allow read, write: if isAdmin();
    }
    match /account_numbers/{id} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENIAL
    // =========================================================================
    // Any other collection or document (such as users, internal collections, etc.)
    // is denied by default in Firestore.
  }
}
