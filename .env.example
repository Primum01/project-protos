# Copy this file to .env.local and fill in your real Firebase project config.
# Get these values from the Firebase console: Project settings > General > Your apps.
# Until real values are supplied, Firebase calls will fail. There is no mock fallback.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
