# =============================================================================
# TwinSpace 360 Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these under: Project Settings > Environment Variables.
# NEVER commit .env or .env.local to Git.
# =============================================================================

# ── 1. PUBLIC CLIENT CONFIGURATION (Vite Frontend) ──────────────────────────
# These parameters identify your Firebase Web App to Google servers.
# In Firebase, Web SDK credentials are baked into client bundles and secured
# by Firebase Authentication, Firestore Security Rules, and Storage Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── 2. SERVER-SIDE ONLY CREDENTIALS (Vercel Serverless Functions) ───────────
# TRUE SECRETS: These MUST NEVER have a VITE_ prefix.
# They are accessible ONLY to serverless functions in /api/ and never reach the browser.
#
# Designated Admin Account Email
ADMIN_EMAIL=team@twinspace360.com

# Server-Side Firebase REST / Admin Credentials (Optional for enhanced server-side operations)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Server-Side Rate Limiting Overrides (Optional)
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_MS=900000
