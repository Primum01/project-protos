rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.lower() == 'team@twinspace360.com';
    }

    // STRICTLY ADMIN-ONLY: Invoices, receipts, and private business documents
    match /listings/{listingId}/documents/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /invoices/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /receipts/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // PUBLIC: Property photos, virtual tour media, and general public assets
    match /listings/{listingId}/photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
